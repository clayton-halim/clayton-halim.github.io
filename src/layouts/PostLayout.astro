---
import BaseLayout from './BaseLayout.astro';
import Nav from '../components/Nav.astro';
import { formatPostDate, parseLegacyDate } from '../utils/dates';
import '../styles/blog.css';

interface Props {
  title: string;
  date: string;
  tags: string[];
  description?: string;
  canonical: string;
}

const { title, date, tags, description, canonical } = Astro.props;
---

<BaseLayout
  title={title}
  description={description ?? title}
  canonical={canonical}
  type="article"
  publishedTime={parseLegacyDate(date).toISOString()}
  tags={tags}
>
  <Nav />
  <article class="blog-post">
    <h1 class="blog-title">{title}</h1>
    <h2 class="blog-date">{formatPostDate(date)}</h2>
    <ul class="tags hlist">
      {tags.map((tag) => (
        <li><code class="tag"><a href={`/tags/${encodeURIComponent(tag)}`}>#{tag}</a></code></li>
      ))}
    </ul>
    <slot />
  </article>
</BaseLayout>
