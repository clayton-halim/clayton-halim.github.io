---
import Head from '../components/Head.astro';
import '../styles/sanitize.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  robots?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  tags?: string[];
}

const props = Astro.props;
---

<!doctype html>
<html lang="en-ca">
  <head>
    <Head {...props} />
  </head>
  <body>
    <div id="content-wrapper">
      <slot />
    </div>
  </body>
</html>
