---
import { SOCIAL_LINKS } from '../consts';
---

<ul class="hlist social-bar">
  <li class="hlist-item">
    <a id="resume" class="social-link" href={SOCIAL_LINKS.resume} title="Resume" aria-label="Resume">
      <i class="fa fa-file"></i>
    </a>
    <a id="github" class="social-link" href={SOCIAL_LINKS.github} aria-label="Github profile">
      <i class="fa fa-github"></i>
    </a>
    <a id="linkedin" class="social-link" href={SOCIAL_LINKS.linkedin} aria-label="Linkedin profile">
      <i class="fa fa-linkedin"></i>
    </a>
    <a id="email" class="social-link" href={SOCIAL_LINKS.email} aria-label="Email">
      <i class="fa fa-envelope"></i>
    </a>
  </li>
</ul>
