---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import PostList from '../../components/PostList.astro';
import { assertUniqueLegacyPaths, sortPostsDescending } from '../../utils/content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  assertUniqueLegacyPaths(posts);
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.map((tag) => ({ params: { tag }, props: { posts, tag } }));
}

const { posts: allPosts, tag } = Astro.props;
const posts = sortPostsDescending(allPosts.filter((post) => post.data.tags.includes(tag)));
---

<BaseLayout title={`#${tag}`} robots="noindex,follow">
  <Nav />
  <h1>#{tag}</h1>
  <PostList posts={posts} />
</BaseLayout>
